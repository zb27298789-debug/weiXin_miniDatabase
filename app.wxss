page {
  background: #f4f7fb;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

button {
  border: 0;
}

.container {
  padding: 20rpx 20rpx 40rpx;
}

.card {
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 12rpx 0 16rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.full-width {
  width: 100%;
}

.input-box {
  flex: 1;
  border: 1rpx solid #dfe7f1;
  border-radius: 12rpx;
  background: #f9fbff;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.picker-box {
  width: 200rpx;
  border: 1rpx solid #dfe7f1;
  border-radius: 12rpx;
  background: #f9fbff;
  padding: 18rpx 20rpx;
  text-align: center;
  font-size: 28rpx;
}

.primary-btn,
.secondary-btn,
.warn-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  min-width: 140rpx;
  height: 72rpx;
  font-size: 28rpx;
}

.primary-btn {
  background: #2d8cff;
  color: white;
}

.secondary-btn {
  background: #eaf3ff;
  color: #2d8cff;
}

.warn-btn {
  background: #ffe9e9;
  color: #e54848;
}

.empty-state {
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
  padding: 30rpx 0;
}
